# Graph endpoint. Leave this for the local HydraDB container, or point it at a
# managed Bolt endpoint such as Neo4j Aura (neo4j+s://<id>.databases.neo4j.io).
HYDRADB_URI=neo4j://127.0.0.1:7687
HYDRADB_USER=hydradb
HYDRADB_PASSWORD=local-development-token-32-bytes
HYDRADB_AUTH_SCHEME=basic
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0
# Only needed when the endpoint hosts more than one database.
HYDRADB_DATABASE=

# Reasoning for the learning pass. Any OpenAI-compatible endpoint works.
SERV_BASE_URL=
SERV_API_KEY=
SERV_MODEL=
SERV_RESPONSE_FORMAT=json_schema

# Bearer token required by the hosted MCP endpoint at /api/mcp.
BLOKS_API_TOKEN=change-me-local-dev-token
