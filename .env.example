# HydraDB (graph + context layer) — Bolt endpoint from docker-compose
HYDRADB_URI=neo4j://127.0.0.1:7687
HYDRADB_USER=hydradb
HYDRADB_PASSWORD=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL_ID=cell-0

# SERV Reasoning (OpenServ) — OpenAI-compatible reasoning engine.
# Get credentials at https://console.openserv.ai/signup
SERV_BASE_URL=
SERV_API_KEY=
SERV_MODEL=

# Shared token the MCP server uses to call the Bloks API
BLOKS_API_URL=http://127.0.0.1:3000
BLOKS_API_TOKEN=change-me-local-dev-token
